# Copy to .env and fill in. Never commit .env.
# Meko API key (portal: Settings > API Keys). Starts with mko_tkn_
MEKO_API_KEY=
# Optional: Anthropic key for the inbox reader and plain-language explanations
ANTHROPIC_API_KEY=
# Optional: the ledger database, a Postgres cluster inside a Meko datapack (AMP). scripts write these once;
# the password is shown only at creation, and the endpoint accepts only the IP in MEKO_PG_ALLOWED_CIDR
MEKO_PG_HOST=
MEKO_PG_PORT=
MEKO_PG_USER=
MEKO_PG_PASSWORD=
MEKO_PG_ALLOWED_CIDR=
MEKO_PG_DATAPACK=
MEKO_PG_CLUSTER_ID=
MEKO_PG_BRANCH_ID=
MEKO_PG_COMPUTE_ID=
